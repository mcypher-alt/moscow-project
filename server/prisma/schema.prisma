datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

enum Role {
    DISPATCHER
    ANALYST
    ADMIN
}

model User {
    id        String             @id @default(uuid())
    email     String             @unique
    password  String
    name      String
    role      Role               @default(DISPATCHER)
    createdAt DateTime           @default(now())

    actions   DispatcherAction[]
    repairDrafts RepairDraft[]
}

// 1. Дерево объектов диспетчера (Скриншот 2)
model SystemObject {
    id             Int            @id // ид_объект (5122, 5123...)
    level          Int            // иерархия_уровень (3)
    objectKind     String         // вид_объекта ("controlHouse", "guardObject")
    dispatcherName String         // диспетчерское_название_объекта ("ДУ объект Альфа")
    latitude       Float?
    longitude      Float?
    address        String?

    // Самоссылающаяся иерархия (родитель -> потомки)
    parentId       Int?           // родитель (5, 6, 7...)
    parent         SystemObject?  @relation("ObjectTree", fields: [parentId], references: [id])
    children       SystemObject[] @relation("ObjectTree")

    channels       SensorChannel[]
    incidents      Incident[]
    forecasts      Forecast[]
    forecastJob    ForecastJob?
    workRequests   WorkRequest[]
    repairDrafts RepairDraft[]

    @@index([parentId])
}

// 2. Справочник каналов датчиков (Скриншот 1)
model SensorChannel {
  id              Int          @id // Внешний ID напрямую из справочника
  systemTag       String
  sensorName      String
  systemType      String
  sensorType      String?
  systemObjectId  Int
  systemObject    SystemObject @relation(fields: [systemObjectId], references: [id])
  events          EventLog[]
  incidents       Incident[]

  @@index([systemObjectId])
}

// 3. Журнал событий / телеметрия (Скриншот 3)
model EventLog {
    id             BigInt        @id // ид_события (4524243389)
    
    channelId      Int           // ид_канала_данных (120473)
    channel        SensorChannel @relation(fields: [channelId], references: [id])

    recordedAt     DateTime      // Объединенные дата + время ("2026-08-01 03:09:27")
    isAlarm        Boolean       @default(false) // тревожное (false / true)
    
    rawValue       String?       // "28", "Снято с охраны", "01.01.1970 03:00:00"
    numericValue   Float?        // Распарсенное число (28.0) для графиков и ML, null для текста

    @@index([channelId, recordedAt(sort: Desc)])
    @@index([recordedAt(sort: Desc)])
    @@index([isAlarm])
}

// 4. Предикты инцидентов от ML
enum IncidentStatus {
    OPEN              // Прогноз получен, ждет реакции
    IN_PROGRESS       // Диспетчер принял меры (отправил бригаду)
    CONFIRMED         // Авария реально подтвердилась / предотвращена
    FALSE_POSITIVE    // Ложное срабатывание (постфактум проверили — всё чисто)
    RESOLVED
}

model Incident {
  id               String             @id @default(uuid())
  systemObjectId   Int
  systemObject     SystemObject       @relation(fields: [systemObjectId], references: [id])

  channelId        Int?
  channel          SensorChannel?     @relation(fields: [channelId], references: [id])

  scenario         String             // Тип инцидента (mlResponse.incidentType)
  probability      Float?
  modelVersion     String?
  forecastId       String?            @unique
  horizon          String             // Человекочитаемый горизонт ("24-48 часов", "2-4 часа")
  reason           String             // Прямая физическая причина (триггер)
  recommendation   String?            // Инструкция для диспетчера

  status           IncidentStatus     @default(OPEN)

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  actions          DispatcherAction[]

  @@index([status])
  @@index([systemObjectId])
  @@index([createdAt])
}

// 5. Действия диспетчера
model DispatcherAction {
    id         String   @id @default(uuid())
    incidentId String
    incident   Incident @relation(fields: [incidentId], references: [id])

    userId     String
    user       User     @relation(fields: [userId], references: [id])

    decision   String   // "Выезд бригады", "Сброс"
    reasonCode String?
    comment    String?
    createdAt  DateTime @default(now())
}

// Durable inference queue: revision prevents losing telemetry arriving during inference.
model ForecastJob {
  systemObjectId Int @id
  systemObject SystemObject @relation(fields: [systemObjectId], references: [id])
  revision Int @default(1)
  updatedAt DateTime @updatedAt
  attempts Int @default(0)
  lastError String?
  retryAt DateTime @default(now())
}

model Forecast {
  id String @id @default(uuid())
  systemObjectId Int
  systemObject SystemObject @relation(fields: [systemObjectId], references: [id])
  evaluatedAt DateTime
  probability Float
  threshold Float
  isIncidentPredicted Boolean
  horizonHours Int
  modelVersion String
  scenario String
  reason String
  recommendation String
  createdAt DateTime @default(now())
  @@unique([systemObjectId, evaluatedAt, modelVersion])
  @@index([createdAt])
}

model WorkRequest {
  externalId String @id
  systemObjectId Int
  systemObject SystemObject @relation(fields: [systemObjectId], references: [id])
  status String
  description String
  startsAt DateTime?
  endsAt DateTime?
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id String @id @default(uuid())
  userId String?
  method String
  path String
  status Int
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model RepairDraft {
  id String @id @default(uuid())
  systemObjectId Int
  systemObject SystemObject @relation(fields: [systemObjectId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "RepairDraft_object_fkey")
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "RepairDraft_user_fkey")
  content String
  recommendationVersion String
  createdAt DateTime @default(now())
  @@index([systemObjectId, createdAt])
}
