{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "seed:dispatchers": "tsx prisma/seed-dispatchers.ts",
    "seed:csv": "tsx prisma/seed-csv.ts",
    "seed:redis": "tsx prisma/seed-redis.ts",
    "seed:all": "npm run seed:dispatchers && npm run seed:csv && npm run seed:redis"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.11.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "lodash": "^4.17.21",
    "valibot": ">=1.0.0",
    "deepmerge-ts": "^7.1.6"
  },
  "prisma": {
    "seed:csv": "tsx prisma/seed-csv.ts",
    "seed:dispatchers": "tsx prisma/seed-dispatchers.ts",
    "seed:all": "npm run seed:dispatchers && npm run seed:csv"
